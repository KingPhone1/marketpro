# Staging only. Do not copy production values into this file.
NODE_ENV=staging
PORT=3085
HOST=0.0.0.0
APP_BASE_URL=https://staging.marketpro.tudominio.com
REQUIRE_PRODUCTION_CONFIG=true

# Separate Supabase project or isolated staging environment.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORE_ID=staging
SUPABASE_PRIVATE_BUCKET=marketpro-staging-private
SUPABASE_PUBLIC_BUCKET=marketpro-staging-public

# Generate separate secrets for staging.
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Mercado Pago test credentials only.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_OAUTH_REDIRECT_URI=https://staging.marketpro.tudominio.com/api/payments/mercadopago/oauth/callback
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_CURRENCY=UYU

# Required guard for scripts/import-relational-store.js.
MIGRATION_TARGET=staging
